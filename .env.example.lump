# ==========================================
# TW AutoTrader 環境設定範例 — 單筆 50 萬元 / 8 檔分散 / 中高風險
# （PC_<代號> JSON 格式，2026-08-31 更新）
# ==========================================

# FinMind 設定（ finmind.github.io 註冊免費取得）
FINMIND_API_TOKEN=your_finmind_api_token_here

# 券商選擇（kgi / esun）
BROKER=kgi

# 凱基 API 設定
KGI_API_KEY=your_kgi_api_key_here
KGI_API_SECRET=your_kgi_api_secret_here
USE_REAL_API=false      # true = 真實下單（使用玉山 SDK）
# ESUN_ENVIRONMENT=simulation  # 玉山環境：simulation=模擬, real=真實

# 玉山 API 設定（BROKER=esun 時使用）
# ESUN_ACCOUNT_PASSWORD=您的密碼
# ESUN_CERT_PASSWORD=您的憑證密碼

# Telegram 通知
TELEGRAM_BOT_TOKEN=您的Telegram機器人Token
TELEGRAM_CHAT_ID=您的Telegram聊天群組ID
# SYS_TELEGRAM_BOT_TOKEN=您的Telegram機器人Token   # 系統通知專用（選擇性；未設則沿用 TELEGRAM_BOT_TOKEN）
# SYS_TELEGRAM_CHAT_ID=您的Telegram聊天群組ID

# LINE Notify（選擇性）
#LINE_NOTIFY_TOKEN=您的LineNotify權杖密碼

# ==========================================
# 資金配置
# ==========================================
TOTAL_CAPITAL=500000            # 可動用總資金
INITIAL_CAPITAL=500000          # 風險計算用初始資金

# DCA 模式設定（0 = 一筆資金 Lumpsum，>0 = 每月定期定額 DCA）
DCA_AMOUNT=0

# ==========================================
# 風險控管
# ==========================================
MAX_RISK_PER_TRADE=0.02         # 單筆最大風險 2%
MAX_DAILY_LOSS=0.03             # 每日最大虧損 3%
MAX_DAILY_TRADES=5              # 每日最大交易次數
CAPITAL_CONTROL_LINE=30         # 剩餘資金低於此 % 才開始限制交易次數
MARKET_TREND_FILTER=true        # 大盤年線過濾

# ==========================================
# 獲利滾入設定
# ==========================================
PROFIT_ROLL_MONTHS=0            # M=0: 每次賣出立即滾入已實現獲利
PROFIT_ROLL_PERCENTAGE=100      # 滾入比例 100%（全部獲利滾入）

# ==========================================
# 全輪替排程設定（Lumpsum 推薦全輪替，自動每季換股）
# ==========================================
ROTATE_MODE=5              # 0=不啟用 1=1/4/7/10 2=2/5/8/11 3=3/6/9/12
                           # 4=1/4/7/10+2/5/8/11（兩段各半） 5=2/5/8/11+3/6/9/12（兩段各半，推薦）
ROTATE_TRADING_DAY_N=-1    # 選股日：-1=每月最後交易日（預設）；N=1~20=每月第 N 個交易日
ROTATE_TOP_N=3              # 每排程選股檔數（3=每檔16.7%，2026-08-30 定案）
MIN_DAILY_AMOUNT=0           # 日均成交額門檻（萬元，0=不啟用；大資金建議 100000=10億）
ROTATE_STOCK_NO=100          # 全輪替候選池：市值前 N 大
ROTATE_LOOKBACK_DAYS=250     # 實盤選股下載近期資料天數（250≈1年）
INST_CONFIRM=1               # 全輪替法人確認濾網：1=啟用
INST_CONFIRM_DAYS=15         # 法人確認回溯交易日
MIN_DRAW_BACK=30              # 全輪替重大回撤保護（0=停用）
ROTATION_BUY_DIRECT=1           # 換股買入獨立路徑：1=跳過 Group1 風控（與回測一致）

# ==========================================
# Group 2 — 法人抬轎動能策略（獨立資金池）
# 誠實池回測不如 0050，不建議實盤使用；動能型請用全輪替
# ==========================================
INST_MOM_CAPITAL=0              # 法人抬轎動能獨立本金（0=關閉；設金額啟用）
IM_DEBUG=1                      # 法人動能除錯：1=未啟用時仍每日搜尋並於睡前TG報告前三名；0=關閉
INST_MOM_MIN_VOLUME=2000        # 最小近 5 日平均成交量（張）
INST_MOM_BUY_RATIO=0.05         # 投信+外資買超佔總成交量門檻（5%）
INST_MOM_LOOKBACK=20            # 創新高天數
INST_MOM_TOP_N=3                # 持有標的數量
INST_MOM_STOP_LOSS=0.10         # 硬性停損 -10%
INST_MOM_TRAILING_PERIOD=20     # 移動停利 MA20
INST_MOM_EXCLUDE_ETF=true       # 排除 ETF（true/false）
# ── 篩選頻率 ──────────────────────────────────────
INST_MOM_DAILY_SCREENING=true   # true=每日篩選隔日進場, false=每週五篩選週一進場
# ── 魚過濾（兩階段篩選：法人低吃 → 動能進場）─────────
INST_MOM_FISH_FILTER=true       # 啟用魚過濾（true/false）
INST_MOM_FISH_DAYS=120          # 魚過濾回溯天數
INST_MOM_FISH_MIN_SCORE=7.0     # 魚過濾最低分數門檻
# ── 獲利滾入（贖回時利潤滾入資金池）─────────────────
INST_MOM_PROFIT_ROLL_MONTHS=0   # M=0: 每筆獲利都滾入；M>0: 每 M 個月滾一次
INST_MOM_PROFIT_ROLL_PCT=1.0    # 滾入比例（0.0~1.0，1.0=100%）
# ── 停損禁入（虧損賣出後 N 天禁再進場）──────────────
INST_MOM_LOSER_BAN_DAYS=0       # 停損禁入天數（0=不啟用）
INST_MOM_MIN_BREAKOUT=0.02      # 進場時需已離開法人成本 ≥2%（0=停用）
INST_MOM_BUY_STREAK_DAYS=1      # 法人淨買超天數（進場日需為買超日；0=停用）

# ==========================================
# Group 1 — 個股策略參數（PC_<代號> JSON 格式）
# 固定標的範例（ROTATE_MODE=0 時生效；全輪替啟用時以選股結果為主）
# ==========================================
PC_0050={"strategy":"bollinger","alloc":35,"window":20,"std_dev":2.0,"rsi_period":5,"position_amount":15000,"monthly_budget":0,"pyramid_enabled":true,"pyramid_tier1_shares":1000,"pyramid_tier2_shares":2000,"pyramid_tier3_shares":3000,"pyramid_tier2_drop":0.03,"pyramid_tier3_drop":0.05}
PC_006208={"strategy":"bollinger","alloc":10,"window":20,"std_dev":2.0,"rsi_period":5,"position_amount":10000,"monthly_budget":0,"pyramid_enabled":true,"pyramid_tier1_shares":1000,"pyramid_tier2_shares":2000,"pyramid_tier3_shares":3000,"pyramid_tier2_drop":0.03,"pyramid_tier3_drop":0.05}
PC_00878={"strategy":"bollinger","alloc":10,"window":20,"std_dev":2.0,"rsi_period":5,"position_amount":10000,"monthly_budget":0,"pyramid_enabled":true,"pyramid_tier1_shares":1000,"pyramid_tier2_shares":2000,"pyramid_tier3_shares":3000,"pyramid_tier2_drop":0.03,"pyramid_tier3_drop":0.05}
PC_2330={"strategy":"ma_cross","alloc":15,"fast_period":14,"slow_period":60,"atr_period":14,"atr_threshold":0.0,"position_amount":10000,"monthly_budget":0}
PC_2454={"strategy":"keep_wait","alloc":15,"initial_shares":12,"add_drop_pct":5,"add_shares":6,"max_additions":2,"tp_trigger_pct":15,"tp_sell_ratio":50,"cooldown_days":30}
PC_2881={"strategy":"vwap","alloc":10,"sigma_mult":1.5,"rsi_period":5,"position_amount":10000,"monthly_budget":0}
PC_2886={"strategy":"vwap","alloc":10,"sigma_mult":1.5,"rsi_period":5,"position_amount":10000,"monthly_budget":0}
PC_2382={"strategy":"breakout","alloc":15,"lookback":20,"atr_period":14,"atr_threshold":0.02,"buy_shares":50,"sell_shares":50}

# ==========================================
# 內部設定（請勿修改）
# ==========================================
# GIT_PAGE=on                        # GitHub Pages 儀表板上傳（內部使用，請勿開啟）
